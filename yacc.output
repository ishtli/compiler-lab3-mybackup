Grammar

    0 $accept: PROGRAM $end

    1 PROGRAM: STMT_LIST
    2        | PROGRAM END

    3 STMT_LIST: STMT
    4          | STMT_LIST STMT

    5 STMT: EXPR_STMT
    6     | VAR_DECL_STMT
    7     | FUNC_DECL_STMT
    8     | FOR_STMT
    9     | IF_STMT
   10     | CONTINUE_STMT
   11     | SEMICOLON
   12     | SLASH_COMMENT
   13     | RETURN_STMT
   14     | WHILE_STMT
   15     | BREAK_STMT
   16     | BLOCK_STMT

   17 CONTINUE_STMT: CONTINUE SEMICOLON

   18 EXPR_STMT: EXPR SEMICOLON

   19 VAR_DECLARATION: TYPE VAR_DECLARATOR_LIST
   20                | CONST TYPE VAR_DECLARATOR_LIST

   21 VAR_DECL_STMT: VAR_DECLARATION SEMICOLON

   22 FUNC_BODY: LBRACE RBRACE
   23          | LBRACE STMT_LIST RBRACE

   24 FUNC_DECL_STMT: TYPE IDENT LPAREN PARAM_DECLARATOR_LIST RPAREN FUNC_BODY

   25 FOR_STMT: FOR LPAREN VAR_DECLARATION SEMICOLON EXPR SEMICOLON EXPR RPAREN STMT
   26         | FOR LPAREN EXPR SEMICOLON EXPR SEMICOLON EXPR RPAREN STMT

   27 IF_STMT: IF LPAREN EXPR RPAREN STMT
   28        | IF LPAREN EXPR RPAREN STMT ELSE STMT

   29 RETURN_STMT: RETURN SEMICOLON
   30            | RETURN EXPR SEMICOLON

   31 WHILE_STMT: WHILE LPAREN EXPR RPAREN STMT

   32 BLOCK_STMT: LBRACE RBRACE
   33           | LBRACE STMT_LIST RBRACE

   34 BREAK_STMT: BREAK SEMICOLON

   35 PARAM_DECLARATOR: TYPE IDENT
   36                 | TYPE IDENT LBRACKET RBRACKET
   37                 | TYPE IDENT ARRAY_DIMENSION_EXPR_LIST
   38                 | TYPE IDENT LBRACKET RBRACKET ARRAY_DIMENSION_EXPR_LIST

   39 PARAM_DECLARATOR_LIST: ε
   40                      | PARAM_DECLARATOR
   41                      | PARAM_DECLARATOR_LIST COMMA PARAM_DECLARATOR

   42 VAR_DECLARATOR: LEFT_VAL_EXPR
   43               | LEFT_VAL_EXPR "=" INITIALIZER

   44 VAR_DECLARATOR_LIST: VAR_DECLARATOR
   45                    | VAR_DECLARATOR_LIST COMMA VAR_DECLARATOR

   46 INITIALIZER: NOCOMMA_EXPR
   47            | LBRACE RBRACE
   48            | LBRACE INITIALIZER_LIST RBRACE

   49 INITIALIZER_LIST: INITIALIZER
   50                 | INITIALIZER_LIST COMMA INITIALIZER

   51 ASSIGN_EXPR: LEFT_VAL_EXPR "=" NOCOMMA_EXPR

   52 EXPR_LIST: NOCOMMA_EXPR
   53          | EXPR_LIST COMMA NOCOMMA_EXPR

   54 EXPR: NOCOMMA_EXPR
   55     | EXPR COMMA NOCOMMA_EXPR

   56 NOCOMMA_EXPR: LOGICAL_OR_EXPR
   57             | ASSIGN_EXPR

   58 LOGICAL_OR_EXPR: LOGICAL_AND_EXPR
   59                | LOGICAL_OR_EXPR "||" LOGICAL_AND_EXPR

   60 LOGICAL_AND_EXPR: EQUALITY_EXPR
   61                 | LOGICAL_AND_EXPR "&&" EQUALITY_EXPR

   62 EQUALITY_EXPR: RELATIONAL_EXPR
   63              | EQUALITY_EXPR "==" RELATIONAL_EXPR
   64              | EQUALITY_EXPR "!=" RELATIONAL_EXPR

   65 RELATIONAL_EXPR: ADDSUB_EXPR
   66                | RELATIONAL_EXPR "<" ADDSUB_EXPR
   67                | RELATIONAL_EXPR "<=" ADDSUB_EXPR
   68                | RELATIONAL_EXPR ">" ADDSUB_EXPR
   69                | RELATIONAL_EXPR ">=" ADDSUB_EXPR

   70 ADDSUB_EXPR: MULDIV_EXPR
   71            | ADDSUB_EXPR "+" MULDIV_EXPR
   72            | ADDSUB_EXPR "-" MULDIV_EXPR

   73 MULDIV_EXPR: UNARY_EXPR
   74            | MULDIV_EXPR "*" UNARY_EXPR
   75            | MULDIV_EXPR "/" UNARY_EXPR
   76            | MULDIV_EXPR "%" UNARY_EXPR

   77 UNARY_EXPR: BASIC_EXPR
   78           | UNARY_OP UNARY_EXPR

   79 BASIC_EXPR: LITERAL_EXPR
   80           | LEFT_VAL_EXPR
   81           | LPAREN EXPR RPAREN
   82           | FUNC_CALL_EXPR

   83 FUNC_CALL_EXPR: IDENT LPAREN RPAREN
   84               | IDENT LPAREN EXPR_LIST RPAREN

   85 ARRAY_DIMENSION_EXPR: LBRACKET NOCOMMA_EXPR RBRACKET

   86 ARRAY_DIMENSION_EXPR_LIST: ARRAY_DIMENSION_EXPR
   87                          | ARRAY_DIMENSION_EXPR_LIST ARRAY_DIMENSION_EXPR

   88 LEFT_VAL_EXPR: IDENT
   89              | IDENT ARRAY_DIMENSION_EXPR_LIST

   90 LITERAL_EXPR: INT_CONST
   91             | LL_CONST
   92             | FLOAT_CONST

   93 TYPE: INT
   94     | FLOAT
   95     | VOID

   96 UNARY_OP: "+"
   97         | "-"
   98         | "!"


